# Copy this file to .env and adjust values before running `make up`.
# NEVER commit the real .env file.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=mini_data_platform
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# MinIO
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_dev_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=raw-data

# ---------------------------------------------------------------------------
# Airflow
# ---------------------------------------------------------------------------
# UID of the host user that should own mounted dag/log files (avoids root-owned
# files on Linux). Run `id -u` and put the result here.
AIRFLOW_UID=50000

AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_dev_only

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_dev_only

AIRFLOW_WEBSERVER_PORT=8080

# ---------------------------------------------------------------------------
# Metabase
# ---------------------------------------------------------------------------
METABASE_PORT=3000

# Used only by `make init-metabase` (scripts/init_metabase.py) for the
# one-time automated admin account it creates on a fresh Metabase instance.
# Change these before running it — the defaults are publicly known.
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=change_me_dev_only
